RAILS_ENV=development
RAILS_MAX_THREADS=5

POSTGRES_USER=oficina_mecanica
POSTGRES_PASSWORD=oficina_mecanica
POSTGRES_DB=oficina_mecanica_development

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USERNAME=oficina_mecanica
DATABASE_PASSWORD=oficina_mecanica

# Broker de eventos entre os microsserviços. Sem esta variável, nenhum evento é publicado.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Endereço do billing-service, usado para compor o orçamento no detalhe da OS.
# Sem esta variável, o campo quote vem nulo.
BILLING_SERVICE_URL=http://host.docker.internal:3001

# Segredo do JWT — precisa ser o mesmo em todos os serviços (o token do usuário é repassado entre eles).
JWT_SECRET=dev-only-shared-jwt-secret
